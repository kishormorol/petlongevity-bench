{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PetLongevityBenchEvidenceRecord",
  "type": "object",
  "required": [
    "record_id", "source_id", "publication_year", "species", "study_type",
    "intervention_or_exposure", "endpoint", "result_direction", "evidence_tier",
    "direct_species_evidence", "efficacy_result", "supporting_span"
  ],
  "properties": {
    "record_id": {"type": "string"},
    "source_id": {"type": "string", "description": "PMID, DOI, or other stable identifier"},
    "publication_year": {"type": "integer"},
    "species": {"type": "array", "items": {"enum": ["dog", "cat", "human", "mouse", "rat", "other"]}},
    "breed": {"type": ["string", "null"]},
    "age_description": {"type": ["string", "null"]},
    "sample_size": {"type": ["integer", "null"]},
    "study_type": {
      "enum": ["RCT", "controlled_trial", "observational", "longitudinal_observational", "in_vitro", "ex_vivo", "multi_omics", "protocol", "review", "other"]
    },
    "intervention_or_exposure": {"type": "string"},
    "comparator": {"type": ["string", "null"]},
    "endpoint": {"type": "string"},
    "endpoint_class": {
      "enum": ["lifespan", "mortality", "healthspan", "cognition", "cardiac", "mobility", "metabolic", "renal", "immune", "epigenetic_age", "omics_biomarker", "safety", "other"]
    },
    "result_direction": {"enum": ["beneficial", "harmful", "null", "mixed", "association_only", "not_applicable"]},
    "effect_size_text": {"type": ["string", "null"]},
    "adverse_events_text": {"type": ["string", "null"]},
    "mechanism_claimed": {"type": ["string", "null"]},
    "evidence_tier": {"enum": ["T0", "T1", "T2", "T3", "T4", "T5"]},
    "direct_species_evidence": {"type": "boolean"},
    "efficacy_result": {"type": "boolean"},
    "funding_or_conflict": {"type": ["string", "null"]},
    "supporting_span": {"type": "string"},
    "annotator_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
