{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PetLongevityBenchResearchDatasetManifest",
  "type": "object",
  "required": ["dataset_id", "schema_version", "dataset_status", "paper_registry_file", "claim_evidence_file", "description", "license"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "dataset_status": {"enum": ["draft", "silver", "gold"]},
    "paper_registry_file": {"type": "string", "minLength": 1},
    "claim_evidence_file": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "version": {"type": "string"}
  },
  "additionalProperties": false
}
