{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PetLongevityBenchClaimEvidencePair",
  "type": "object",
  "required": ["pair_id", "paper_id", "claim_id", "claim_text", "source_id", "publication_date", "provenance_url", "source_text_sha256", "supporting_span", "species", "study_design", "outcome", "intervention_type", "evidence_strength", "label", "correlation_vs_causation", "protocol_vs_results", "review"],
  "properties": {
    "pair_id": {"type": "string", "minLength": 1},
    "paper_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_text": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "publication_date": {"type": "string", "format": "date"},
    "provenance_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "source_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_text_path": {"type": "string", "minLength": 1},
    "supporting_span": {"$ref": "#/$defs/span"},
    "species": {"type": "array", "minItems": 1, "items": {"enum": ["dog", "cat", "mouse", "human", "other"]}},
    "study_design": {"enum": ["RCT", "controlled trial", "cohort", "observational", "case study", "in vitro", "review", "protocol"]},
    "outcome": {"enum": ["lifespan", "mortality", "cognition", "mobility", "metabolic", "renal", "cardiac", "cancer", "biomarker"]},
    "intervention_type": {"enum": ["drug", "nutrient", "diet", "lifestyle", "biomarker-only"]},
    "evidence_strength": {"enum": ["very_low", "low", "moderate", "high", "very_high"]},
    "label": {"enum": ["supported", "contradicted", "insufficient"]},
    "correlation_vs_causation": {"enum": ["causal", "correlational", "unclear"]},
    "protocol_vs_results": {"enum": ["protocol", "results", "not_applicable"]},
    "review": {"$ref": "#/$defs/review"}
  },
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "required": ["text", "start_char", "end_char"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "reviewer": {"type": "object", "required": ["annotator_id"], "properties": {"annotator_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "review": {
      "type": "object",
      "required": ["annotator_a", "annotator_b", "adjudicator", "status", "notes"],
      "properties": {
        "annotator_a": {"$ref": "#/$defs/reviewer"},
        "annotator_b": {"$ref": "#/$defs/reviewer"},
        "adjudicator": {"$ref": "#/$defs/reviewer"},
        "status": {"enum": ["draft", "adjudicated"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
