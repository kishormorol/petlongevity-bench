{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PetLongevityBenchTemporalSnapshotManifest",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "source", "retrieval_query", "retrieved_at", "effective_cutoff", "records_file", "records_sha256", "records_content_sha256", "record_count", "version_registry"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "retrieval_query": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 1},
    "effective_cutoff": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "records_file": {"type": "string", "minLength": 1},
    "records_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "records_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "version_registry": {"type": "array", "items": {"$ref": "#/$defs/version"}}
  },
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "object",
      "required": ["name", "kind", "version", "effective_date", "provenance_url"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["database", "knowledge_graph"]},
        "version": {"type": "string", "minLength": 1},
        "effective_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "provenance_url": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
