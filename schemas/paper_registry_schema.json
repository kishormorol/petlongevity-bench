{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PetLongevityBenchPaperRegistryRecord",
  "type": "object",
  "required": ["paper_id", "pmid", "doi", "title", "publication_year", "publication_date", "species", "provenance_url"],
  "properties": {
    "paper_id": {"type": "string", "minLength": 1},
    "pmid": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "doi": {"type": ["string", "null"], "pattern": "^10\\.[0-9]{4,9}/\\S+$"},
    "title": {"type": "string", "minLength": 1},
    "publication_year": {"type": "integer", "minimum": 1800, "maximum": 3000},
    "publication_date": {"type": "string", "format": "date"},
    "species": {"type": "array", "minItems": 1, "items": {"enum": ["dog", "cat", "mouse", "human", "other"]}},
    "provenance_url": {"type": "string", "format": "uri", "pattern": "^https?://"}
  },
  "anyOf": [{"properties": {"pmid": {"type": "string"}}}, {"properties": {"doi": {"type": "string"}}}],
  "additionalProperties": false
}
